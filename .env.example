# Only the source you use is required.
LARK_APP_ID=
LARK_APP_SECRET=
ANTHROPIC_API_KEY=          # optional; without it you get titles instead of summaries
DIGEST_WEBHOOK_URL=         # Slack/Lark/Teams-style incoming webhook
